<link rel="stylesheet" href="https://unpkg.com/easymde@2.18.0/dist/easymde.min.css">
<div class="panel panel-default">
	<div class="panel-body" style="padding: 30px;">
		<h1 style="font-size: 24px; margin-top: 0; margin-bottom: 24px;">Create entry{{^IS_ROOT_ENTRY}} in {{ENTRY_TOPIC}}{{/IS_ROOT_ENTRY}}</h1>

		{{#HAS_SUCCESS_MESSAGE}}
		<div class="alert alert-success" role="alert">{{SUCCESS_MESSAGE}}</div>
		{{/HAS_SUCCESS_MESSAGE}}
		{{#HAS_INFO_MESSAGE}}
		<div class="alert alert-info" role="status">{{INFO_MESSAGE}}</div>
		{{/HAS_INFO_MESSAGE}}
		{{#HAS_ERROR_MESSAGE}}
		<div class="alert alert-danger" role="alert">{{ERROR_MESSAGE}}</div>
		{{/HAS_ERROR_MESSAGE}}

		<form action="/createentry{{^IS_ROOT_ENTRY}}/{{ENTRY_TOPIC}}{{/IS_ROOT_ENTRY}}" method="post" enctype="multipart/form-data">
			<input type="hidden" name="csrfToken" value="{{CSRF_TOKEN}}">
			<div class="form-group">
				<label for="entry-name" class="control-label">{{STRING_ENTRY_NAME}}</label>
				<input type="text" class="form-control" id="entry-name" name="entryName" value="{{ENTRY_NAME}}" placeholder="example-entry" required>
			</div>
			<div class="form-group" style="margin-bottom: 24px;">
				<label for="entry-content" class="control-label">{{STRING_CONTENT_MARKDOWN}}</label>
				<textarea id="entry-content" name="content">{{ENTRY_CONTENT}}</textarea>
			</div>
			<div class="checkbox" style="margin-bottom: 24px;">
				{{^IS_ROOT_ENTRY}}<label><input type="checkbox" name="published" value="true"{{#ENTRY_PUBLISHED}} checked{{/ENTRY_PUBLISHED}}> {{STRING_PUBLISHED}}</label>{{/IS_ROOT_ENTRY}}
			</div>
			<button type="submit" class="btn btn-primary">{{STRING_SUBMIT}}</button>
			<a class="btn btn-default" href="/{{ENTRY_TOPIC}}">{{STRING_CANCEL}}</a>
		</form>
	</div>
</div>
<script src="https://unpkg.com/easymde@2.18.0/dist/easymde.min.js"></script>
<script>
	window.entryEditor = new EasyMDE({ element: document.getElementById('entry-content'), spellChecker: false, forceSync: true });
</script>
{{>imagemanager.template}}
{{>filemanager.template}}
