{{>html_start.template}}
{{>navbar.template}}

{{{DATA}}}

{{#IS_INDEX}}
    {{#LOGGED_IN}}
        <p><a href="/editentry/{{PAGE_TITLE}}">Edit</a></p>
    {{/LOGGED_IN}}
{{/IS_INDEX}}

{{#IS_ENTRY_VIEW}}
    {{#LOGGED_IN}}
        <p><a href="/editentry{{^IS_ROOT_ENTRY}}/{{ENTRY_TOPIC}}{{/IS_ROOT_ENTRY}}/{{ENTRY_NAME}}">Edit</a></p>
        <form action="/deleteentry{{^IS_ROOT_ENTRY}}/{{ENTRY_TOPIC}}{{/IS_ROOT_ENTRY}}/{{ENTRY_NAME}}" method="post" onsubmit="return confirm('Delete this entry?');">
            <input type="hidden" name="csrfToken" value="{{CSRF_TOKEN}}">
            <button type="submit">Delete</button>
        </form>
    {{/LOGGED_IN}}
{{/IS_ENTRY_VIEW}}

{{#IS_TOPIC_LISTING}}
    {{#LOGGED_IN}}
        <h2><a href="/createentry/{{category}}">New</a></h2>
    {{/LOGGED_IN}}
    {{#ENTRIES}}
        <h2><a href="/{{category}}/{{name}}">{{name}}</a><br/></h2>
    {{/ENTRIES}}
{{/IS_TOPIC_LISTING}}

{{#LOGIN}}
    {{>login.template}}
{{/LOGIN}}

{{#USER_DETAILS}}
    {{>user.template}}
{{/USER_DETAILS}}

{{#IS_CREATE_TOPIC}}
    {{>createtopic.template}}
{{/IS_CREATE_TOPIC}}

{{#IS_CREATE_ENTRY}}
    {{>createentry.template}}
{{/IS_CREATE_ENTRY}}

{{#IS_EDIT_ENTRY}}
    {{>editentry.template}}
{{/IS_EDIT_ENTRY}}

{{>html_end.template}}
