<div style="display: flex; justify-content: center; align-items: center; min-height: 50vh;">
	<div class="panel panel-default" style="width: 100%; max-width: 520px;">
		<div class="panel-body" style="padding: 30px;">
			<h1 class="text-center" style="font-size: 24px; margin-top: 0; margin-bottom: 10px;">Create topic</h1>
			<p class="text-center text-muted" style="margin-bottom: 24px;">Choose the template name to use for the new topic request.</p>

			{{#HAS_SUCCESS_MESSAGE}}
			<div class="alert alert-success" role="alert">{{SUCCESS_MESSAGE}}</div>
			{{/HAS_SUCCESS_MESSAGE}}
			{{#HAS_INFO_MESSAGE}}
			<div class="alert alert-info" role="status">{{INFO_MESSAGE}}</div>
			{{/HAS_INFO_MESSAGE}}
			{{#HAS_ERROR_MESSAGE}}
			<div class="alert alert-danger" role="alert">{{ERROR_MESSAGE}}</div>
			{{/HAS_ERROR_MESSAGE}}

			<form action="/createtopic" method="post" novalidate>
				<input type="hidden" name="csrfToken" value="{{CSRF_TOKEN}}">
				<div class="form-group" style="margin-bottom: 24px;">
					<label for="template-name" class="control-label">Template name</label>
					<input type="text" class="form-control" id="template-name" name="templateName" placeholder="example-template" required>
				</div>
				<button type="submit" class="btn btn-primary btn-block">Submit</button>
			</form>
		</div>
	</div>
</div>
