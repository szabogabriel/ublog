<link rel="stylesheet" href="https://unpkg.com/easymde@2.18.0/dist/easymde.min.css">
<section class="login-panel entry-editor" aria-labelledby="create-entry-title">
	<h2 id="create-entry-title">Create entry{{^IS_ROOT_ENTRY}} in {{ENTRY_TOPIC}}{{/IS_ROOT_ENTRY}}</h2>
	{{#HAS_SUCCESS_MESSAGE}}
	<div style="margin-bottom: 18px; padding: 12px 14px; color: #174538; background: #dfeee4; border-left: 3px solid #286452; font: 13px/1.5 var(--sans);" role="status">{{SUCCESS_MESSAGE}}</div>
	{{/HAS_SUCCESS_MESSAGE}}
	{{#HAS_INFO_MESSAGE}}
	<div style="margin-bottom: 18px; padding: 12px 14px; color: #23546b; background: #e3eef3; border-left: 3px solid #5f8ea1; font: 13px/1.5 var(--sans);" role="status">{{INFO_MESSAGE}}</div>
	{{/HAS_INFO_MESSAGE}}
	{{#HAS_ERROR_MESSAGE}}
	<div style="margin-bottom: 18px; padding: 12px 14px; color: #7a2f24; background: #f7e6e0; border-left: 3px solid #e45e3a; font: 13px/1.5 var(--sans);" role="alert">{{ERROR_MESSAGE}}</div>
	{{/HAS_ERROR_MESSAGE}}

	<form action="/createentry{{^IS_ROOT_ENTRY}}/{{ENTRY_TOPIC}}{{/IS_ROOT_ENTRY}}" method="post" enctype="multipart/form-data">
		<input type="hidden" name="csrfToken" value="{{CSRF_TOKEN}}">
		<div class="login-field">
			<label for="entry-name">ENTRY NAME</label>
			<input type="text" id="entry-name" name="entryName" value="{{ENTRY_NAME}}" placeholder="example-entry" required>
		</div>
		<div class="login-field">
			<label for="entry-content">CONTENT (MARKDOWN)</label>
			<textarea id="entry-content" name="content">{{ENTRY_CONTENT}}</textarea>
		</div>
		<div class="login-field">
			<label class="login-check"><input type="checkbox" name="published" value="true"{{#ENTRY_PUBLISHED}} checked{{/ENTRY_PUBLISHED}}> PUBLISHED</label>
		</div>
		<button class="login-submit" type="submit">Submit</button>
		<a class="login-cancel" href="/{{ENTRY_TOPIC}}">Cancel</a>
	</form>
</section>
<script src="https://unpkg.com/easymde@2.18.0/dist/easymde.min.js"></script>
<script>
	window.entryEditor = new EasyMDE({ element: document.getElementById('entry-content'), spellChecker: false, forceSync: true });
</script>
{{^IS_ROOT_ENTRY}}
{{>imagemanager.template}}
{{/IS_ROOT_ENTRY}}
