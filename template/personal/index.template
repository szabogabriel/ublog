{{>html_start.template}}
{{>navbar.template}}
<main class="page-shell">
  {{#IS_INDEX}}
  <section class="opening" aria-labelledby="opening-title">
    <div class="opening-copy">
      <p class="eyebrow"><span class="eyebrow-mark"></span> A PERSONAL JOURNAL <span class="eyebrow-divider">/</span> {{PAGE_TITLE}}</p>
      <h1 id="opening-title">{{INDEX_TITLE}}</h1>
      <p class="opening-note">Stories, places, and small things worth keeping.</p>
      <a class="text-link" href="#latest">Read the latest <span aria-hidden="true">&darr;</span></a>
    </div>
    <div class="opening-image" role="img" aria-label="A quiet mountain lake at the end of the day">
      <span class="image-caption">NOTES FROM HERE AND THERE</span>
    </div>
  </section>
  {{/IS_INDEX}}
  {{^IS_INDEX}}
  <section class="page-header" aria-labelledby="page-title">
    <p class="eyebrow"><span class="eyebrow-mark"></span> A PERSONAL JOURNAL</p>
    <h1 id="page-title">{{PAGE_TITLE}}</h1>
  </section>
  {{/IS_INDEX}}

  <div class="content-grid" id="latest">
    <section class="writing-column" aria-label="Blog content">
      <div class="section-heading">
        <p class="eyebrow">THE JOURNAL</p>
        <span class="section-rule"></span>
      </div>
      <article class="prose">{{{DATA}}}</article>
      {{#IS_ENTRY_VIEW}}
        {{#LOGGED_IN}}
          <p><a class="text-link" href="/editentry/{{ENTRY_TOPIC}}/{{ENTRY_NAME}}">Edit</a></p>
        {{/LOGGED_IN}}
      {{/IS_ENTRY_VIEW}}
      {{#IS_TOPIC_LISTING}}
        {{#LOGGED_IN}}
          <a class="entry-row" href="/createentry/{{category}}">
            <span class="entry-label">FIELD NOTE</span>
            <span class="entry-title">New</span>
            <span class="entry-category">{{category}}</span>
            <span class="entry-arrow" aria-hidden="true">&rarr;</span>
          </a>
        {{/LOGGED_IN}}
        {{#ENTRIES}}
          <a class="entry-row" href="/{{category}}/{{name}}">
            <span class="entry-label">FIELD NOTE</span>
            <span class="entry-title">{{name}}</span>
            <span class="entry-category">{{category}}</span>
            <span class="entry-arrow" aria-hidden="true">&rarr;</span>
          </a>
        {{/ENTRIES}}
      {{/IS_TOPIC_LISTING}}
      
      {{#LOGIN}}
        {{>login.template}}
      {{/LOGIN}}
      
      {{#USER_DETAILS}}
        {{>user.template}}
      {{/USER_DETAILS}}
      
      {{#IS_CREATE_TOPIC}}
        {{>createtopic.template}}
      {{/IS_CREATE_TOPIC}}

      {{#IS_CREATE_ENTRY}}
        {{>createentry.template}}
      {{/IS_CREATE_ENTRY}}

      {{#IS_EDIT_ENTRY}}
        {{>editentry.template}}
      {{/IS_EDIT_ENTRY}}
    </section>

    <aside class="sidebar">
      <section class="sidebar-section">
        <p class="eyebrow">BROWSE BY TOPIC</p>
        <ul class="topic-list">
          {{#TOPICS}}<li><a href="/{{name}}">{{name}}<span aria-hidden="true">&nearr;</span></a></li>{{/TOPICS}}
          {{#LOGGED_IN}}<li><a href="/createtopic">New</a></li>{{/LOGGED_IN}}
        </ul>
      </section>
      <section class="sidebar-section">
        <p class="eyebrow">A FEW MORE THINGS</p>
        <ul class="topic-list">
          {{#QUICK_LINKS}}<li><a href="/{{name}}">{{name}}<span aria-hidden="true">&nearr;</span></a></li>{{/QUICK_LINKS}}
        </ul>
      </section>
      <div class="sidebar-note">
        <span class="note-symbol" aria-hidden="true">*</span>
        <p>Made slowly, shared openly.</p>
      </div>
    </aside>
  </div>
</main>
{{>html_end.template}}