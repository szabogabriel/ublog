{{>html_start.template}}
{{>navbar.template}}
<main class="page-shell">
  {{#IS_INDEX}}
  <section class="opening" aria-labelledby="opening-title">
    <div class="opening-copy">
      <p class="eyebrow"><span class="eyebrow-mark"></span> {{STRING_JOURNAL_TAGLINE}} <span class="eyebrow-divider">/</span> {{PAGE_TITLE}}</p>
      <h1 id="opening-title">{{STRING_INDEX_TITLE}}</h1>
      <p class="opening-note">{{STRING_INDEX_SUBTITLE}}</p>
      <a class="text-link" href="#latest">{{STRING_READ_LATEST}} <span aria-hidden="true">&darr;</span></a>
    </div>
    <div class="opening-image" role="img" aria-label="{{STRING_OPENING_IMAGE_LABEL}}">
      <span class="image-caption">{{STRING_IMAGE_CAPTION}}</span>
    </div>
  </section>
  {{/IS_INDEX}}
  {{^IS_INDEX}}
  <section class="page-header" aria-labelledby="page-title">
    <p class="eyebrow"><span class="eyebrow-mark"></span> {{STRING_JOURNAL_TAGLINE}}</p>
    <h1 id="page-title">{{PAGE_TITLE}}</h1>
  </section>
  {{/IS_INDEX}}

  <div class="content-grid" id="latest">
    <section class="writing-column" aria-label="{{STRING_BLOG_CONTENT}}">
      <div class="section-heading">
        <p class="eyebrow">{{STRING_JOURNAL}}</p>
        <span class="section-rule"></span>
      </div>
      <article class="prose">{{{DATA}}}</article>
      {{#IS_INDEX}}
        {{#LOGGED_IN}}
          <p><a class="text-link" href="/editentry/{{PAGE_TITLE}}">{{STRING_EDIT}}</a></p>
        {{/LOGGED_IN}}
      {{/IS_INDEX}}
      {{#IS_ENTRY_VIEW}}
        {{#LOGGED_IN}}
          <p><a class="text-link" href="/editentry{{^IS_ROOT_ENTRY}}/{{ENTRY_TOPIC}}{{/IS_ROOT_ENTRY}}/{{ENTRY_NAME}}">{{STRING_EDIT}}</a></p>
          <form action="/deleteentry{{^IS_ROOT_ENTRY}}/{{ENTRY_TOPIC}}{{/IS_ROOT_ENTRY}}/{{ENTRY_NAME}}" method="post" onsubmit="return confirm(document.body.dataset.stringConfirmDeleteEntry);">
            <input type="hidden" name="csrfToken" value="{{CSRF_TOKEN}}">
            <button type="submit" class="text-link">{{STRING_DELETE}}</button>
          </form>
        {{/LOGGED_IN}}
      {{/IS_ENTRY_VIEW}}
      {{#IS_TOPIC_LISTING}}
        {{#LOGGED_IN}}
          <a class="entry-row" href="/createentry/{{category}}">
            <span class="entry-label">{{STRING_FIELD_NOTE}}</span>
            <span class="entry-title">{{STRING_NEW}}</span>
            <span class="entry-meta"><span class="entry-category">{{category}}</span></span>
            <span class="entry-arrow" aria-hidden="true">&rarr;</span>
          </a>
        {{/LOGGED_IN}}
        {{#ENTRIES}}
          <a class="entry-row" href="/{{category}}/{{name}}">
            <span class="entry-label">{{STRING_FIELD_NOTE}}</span>
            <span class="entry-title">{{name}}{{#UNLISTED}} <em>{{STRING_UNLISTED}}</em>{{/UNLISTED}}</span>
            <span class="entry-meta">
              <span class="entry-category">{{category}}</span>
              {{#LOGGED_IN}}<button type="button" class="entry-copy" data-link="{{DIRECT_LINK}}" onclick="event.preventDefault(); event.stopPropagation(); navigator.clipboard.writeText(location.origin + this.dataset.link); this.textContent = document.body.dataset.stringCopied;">{{STRING_COPY_LINK}}</button>{{/LOGGED_IN}}
            </span>
            <span class="entry-arrow" aria-hidden="true">&rarr;</span>
          </a>
        {{/ENTRIES}}
      {{/IS_TOPIC_LISTING}}
      
      {{#LOGIN}}
        {{>login.template}}
      {{/LOGIN}}
      
      {{#USER_DETAILS}}
        {{>user.template}}
      {{/USER_DETAILS}}
      
      {{#IS_CREATE_TOPIC}}
        {{>createtopic.template}}
      {{/IS_CREATE_TOPIC}}

      {{#IS_CREATE_ENTRY}}
        {{>createentry.template}}
      {{/IS_CREATE_ENTRY}}

      {{#IS_EDIT_ENTRY}}
        {{>editentry.template}}
      {{/IS_EDIT_ENTRY}}
    </section>

    <aside class="sidebar">
      <section class="sidebar-section">
        <p class="eyebrow">{{STRING_BROWSE_BY_TOPIC}}</p>
        <ul class="topic-list">
          {{#TOPICS}}<li><a href="/{{name}}">{{name}}<span aria-hidden="true">&nearr;</span></a></li>{{/TOPICS}}
          {{#LOGGED_IN}}<li><a href="/createtopic">{{STRING_NEW}}</a></li>{{/LOGGED_IN}}
        </ul>
      </section>
      <section class="sidebar-section">
        <p class="eyebrow">{{STRING_MORE_THINGS}}</p>
        <ul class="topic-list">
          {{#QUICK_LINKS}}<li><a href="/{{name}}">{{name}}<span aria-hidden="true">&nearr;</span></a></li>{{/QUICK_LINKS}}
        </ul>
      </section>
      <div class="sidebar-note">
        <span class="note-symbol" aria-hidden="true">*</span>
        <p>{{STRING_SIDEBAR_NOTE}}</p>
      </div>
    </aside>
  </div>
</main>
{{>html_end.template}}