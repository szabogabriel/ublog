<style>
  :root {
    --brand: {{COLOR_BRAND}};
    --brand-dark: {{COLOR_BRAND_DARK}};
    --accent: {{COLOR_ACCENT}};
    --ink: {{COLOR_INK}};
    --text: #334155;
    --muted: #64748b;
    --line: #e2e8f0;
    --bg: #ffffff;
    --bg-alt: #f8fafc;
    --radius: 12px;
    --shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    --sans: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 80px; }
  body { margin: 0; font: 16px/1.65 var(--sans); color: var(--text); background: var(--bg); -webkit-font-smoothing: antialiased; }
  a { color: var(--brand); }
  h1, h2, h3, h4 { color: var(--ink); line-height: 1.2; margin: 0; }
  p { margin: 0; }
  ul, ol { margin: 0; padding: 0; }
  [data-visible="false"] { display: none !important; }

  .container { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
  .container-narrow { width: min(780px, calc(100% - 48px)); }

  /* Buttons */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; border: 1px solid transparent; border-radius: 8px; font: 600 14px/1.2 var(--sans); text-decoration: none; cursor: pointer; transition: background .15s, border-color .15s, transform .15s; }
  .btn:hover { transform: translateY(-1px); }
  .btn-primary { background: var(--brand); color: #fff; }
  .btn-primary:hover { background: var(--brand-dark); }
  .btn-secondary { background: #fff; color: var(--ink); border-color: var(--line); }
  .btn-secondary:hover { border-color: var(--brand); color: var(--brand); }
  .btn-ghost { background: transparent; color: var(--text); border-color: transparent; }
  .btn-ghost:hover { color: var(--brand); }
  .btn-light { background: #fff; color: var(--brand-dark); }
  .btn-danger { background: #fff; color: #b42318; border-color: #fecdca; }
  .btn-large { padding: 14px 24px; font-size: 15px; }
  .btn-small { padding: 4px 10px; font-size: 12px; }
  .btn-block { width: 100%; }

  /* Header */
  .site-header { position: sticky; top: 0; z-index: 10; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .nav-wrap { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .brand-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 9px; background: linear-gradient(135deg, var(--brand), var(--accent)); color: #fff; font-weight: 800; }
  .brand-name { font-weight: 700; font-size: 18px; letter-spacing: -0.01em; }
  .nav { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; justify-content: flex-end; }
  .nav-links { display: flex; gap: 22px; list-style: none; flex-wrap: wrap; }
  .nav-links a, .nav-link { color: var(--text); text-decoration: none; font-size: 14px; font-weight: 500; }
  .nav-links a:hover, .nav-link:hover { color: var(--brand); }
  .nav-actions { display: flex; align-items: center; gap: 14px; }
  .nav-actions form { margin: 0; }

  /* Hero */
  .hero { padding: 88px 0 72px; background: radial-gradient(900px 420px at 85% -10%, rgba(47, 91, 234, 0.12), transparent 70%), radial-gradient(700px 380px at 0% 0%, rgba(20, 184, 166, 0.10), transparent 70%); }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; }
  .eyebrow { display: inline-block; margin-bottom: 14px; color: var(--brand); font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .hero h1 { font-size: clamp(34px, 5vw, 56px); font-weight: 800; letter-spacing: -0.03em; }
  .lead { margin-top: 18px; font-size: 18px; color: var(--muted); max-width: 60ch; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
  .hero-note { margin-top: 14px; font-size: 13px; color: var(--muted); }

  .mockup { background: #fff; border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow); overflow: hidden; }
  .mockup-bar { display: flex; gap: 6px; padding: 12px 14px; background: var(--bg-alt); border-bottom: 1px solid var(--line); }
  .mockup-bar span { width: 10px; height: 10px; border-radius: 50%; background: #cbd5e1; }
  .mockup-body { padding: 24px; }
  .mockup-title { font-size: 13px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .mockup-metric { margin-top: 6px; font-size: 44px; font-weight: 800; color: var(--ink); letter-spacing: -0.03em; }
  .mockup-label { color: var(--muted); font-size: 14px; margin-bottom: 18px; }
  .mockup-row { margin-top: 14px; font-size: 14px; color: var(--ink); font-weight: 500; }
  .mockup-row i { display: block; height: 8px; margin-top: 6px; border-radius: 99px; background: linear-gradient(90deg, var(--brand), var(--accent)); }

  /* Stats */
  .stats { border-block: 1px solid var(--line); background: var(--bg-alt); }
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; padding: 36px 0; text-align: center; }
  .stats-grid strong { display: block; font-size: 32px; font-weight: 800; color: var(--ink); letter-spacing: -0.02em; }
  .stats-grid span { color: var(--muted); font-size: 14px; }

  /* Sections */
  .section { padding: 88px 0; }
  .section-alt { background: var(--bg-alt); border-block: 1px solid var(--line); }
  .section-head { max-width: 680px; margin: 0 auto 48px; text-align: center; }
  .section-head h2 { font-size: clamp(26px, 3.4vw, 38px); font-weight: 800; letter-spacing: -0.02em; }
  .section-head .lead { margin-inline: auto; }
  .grid { display: grid; gap: 24px; }
  .grid-3 { grid-template-columns: repeat(3, 1fr); }
  .card { padding: 28px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); transition: box-shadow .2s, transform .2s; }
  .card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .card-icon { display: grid; place-items: center; width: 40px; height: 40px; margin-bottom: 16px; border-radius: 10px; background: rgba(47, 91, 234, 0.1); color: var(--brand); font-size: 13px; font-weight: 700; }
  .card h3 { font-size: 18px; margin-bottom: 8px; }
  .card p { color: var(--muted); font-size: 15px; }

  .steps { list-style: none; counter-reset: step; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .steps li { counter-increment: step; padding: 28px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); }
  .steps li::before { content: counter(step); display: grid; place-items: center; width: 36px; height: 36px; margin-bottom: 16px; border-radius: 50%; background: var(--brand); color: #fff; font-weight: 700; }
  .steps h3 { font-size: 18px; margin-bottom: 8px; }
  .steps p { color: var(--muted); font-size: 15px; }

  .quote { margin: 0; padding: 48px; text-align: center; background: linear-gradient(135deg, var(--brand), var(--brand-dark)); border-radius: 20px; color: #fff; }
  .quote blockquote { margin: 0 auto; max-width: 720px; font-size: clamp(20px, 2.6vw, 28px); font-weight: 600; line-height: 1.4; letter-spacing: -0.01em; }
  .quote figcaption { margin-top: 22px; display: flex; flex-direction: column; gap: 2px; font-size: 14px; }
  .quote figcaption span { opacity: 0.8; }

  /* Pricing */
  .pricing { align-items: stretch; }
  .plan { position: relative; display: flex; flex-direction: column; padding: 32px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); }
  .plan-featured { border-color: var(--brand); box-shadow: var(--shadow); }
  .plan-badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); padding: 3px 12px; border-radius: 99px; background: var(--brand); color: #fff; font-size: 12px; font-weight: 700; white-space: nowrap; }
  .plan h3 { font-size: 20px; }
  .plan-desc { margin-top: 6px; color: var(--muted); font-size: 14px; }
  .plan-price { margin: 22px 0; display: flex; flex-direction: column; }
  .plan-price strong { font-size: 40px; font-weight: 800; color: var(--ink); letter-spacing: -0.03em; line-height: 1.1; }
  .plan-price span { color: var(--muted); font-size: 13px; }
  .plan ul { list-style: none; flex: 1; margin-bottom: 26px; display: grid; gap: 10px; }
  .plan li { position: relative; padding-left: 26px; font-size: 15px; }
  .plan li::before { content: "\2713"; position: absolute; left: 0; color: var(--accent); font-weight: 800; }

  /* FAQ */
  .faq { border-bottom: 1px solid var(--line); padding: 18px 0; }
  .faq summary { cursor: pointer; font-weight: 600; color: var(--ink); list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; color: var(--brand); font-size: 20px; line-height: 1; }
  .faq[open] summary::after { content: "\2212"; }
  .faq p { margin-top: 10px; color: var(--muted); }

  /* CTA */
  .cta { padding: 80px 0; text-align: center; color: #fff; background: linear-gradient(135deg, var(--brand-dark), var(--brand)); }
  .cta h2 { color: #fff; font-size: clamp(26px, 3.4vw, 38px); font-weight: 800; letter-spacing: -0.02em; }
  .cta p { margin: 12px 0 28px; opacity: 0.85; font-size: 18px; }

  /* Inner pages */
  .page-head { padding: 56px 0 32px; background: var(--bg-alt); border-bottom: 1px solid var(--line); }
  .page-head h1 { font-size: clamp(28px, 4vw, 44px); font-weight: 800; letter-spacing: -0.02em; }
  .breadcrumb { margin-bottom: 10px; font-size: 13px; color: var(--muted); }
  .breadcrumb a { color: var(--muted); }
  .page-body { padding: 56px 0 88px; }
  .messages .message:first-child { margin-top: 24px; }
  .message { margin-bottom: 18px; padding: 12px 16px; border-radius: 8px; border-left: 4px solid; font-size: 14px; }
  .message-success { color: #05603a; background: #ecfdf3; border-color: #12b76a; }
  .message-info { color: #175cd3; background: #eff8ff; border-color: #2e90fa; }
  .message-error { color: #b42318; background: #fef3f2; border-color: #f04438; }

  .prose { color: var(--text); font-size: 17px; }
  .prose h1, .prose h2, .prose h3 { margin: 1.6em 0 0.5em; }
  .prose h1:first-child, .prose h2:first-child, .prose h3:first-child { margin-top: 0; }
  .prose p, .prose ul, .prose ol { margin: 0 0 1.1em; }
  .prose ul, .prose ol { padding-left: 1.4em; }
  .prose img { max-width: 100%; height: auto; border-radius: var(--radius); }
  .prose code { padding: 2px 6px; border-radius: 6px; background: var(--bg-alt); font-size: 0.9em; }
  .prose pre { padding: 16px; overflow: auto; border-radius: var(--radius); background: var(--ink); color: #e2e8f0; }
  .prose pre code { background: none; padding: 0; }
  .prose blockquote { margin: 0 0 1.1em; padding-left: 16px; border-left: 4px solid var(--brand); color: var(--muted); }
  .prose table { border-collapse: collapse; width: 100%; margin-bottom: 1.1em; }
  .prose th, .prose td { padding: 8px 12px; border: 1px solid var(--line); text-align: left; }

  .admin-actions { display: flex; gap: 12px; margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--line); }
  .admin-actions form { margin: 0; }

  .entry-list { display: grid; gap: 16px; margin-top: 8px; }
  .entry-card { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 24px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; color: var(--brand); font-size: 14px; font-weight: 600; transition: box-shadow .2s, transform .2s; }
  .entry-card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .entry-card h3 { font-size: 18px; }
  .entry-card-new { border-style: dashed; }

  /* Forms */
  .panel { margin: 0 auto; max-width: 440px; padding: 32px; background: #fff; border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow); }
  .panel-wide { max-width: none; margin-top: 24px; }
  .panel h2 { font-size: 24px; }
  .panel h3 { margin: 28px 0 16px; font-size: 18px; }
  .panel-hint { margin: 6px 0 20px; color: var(--muted); font-size: 14px; }
  .field { margin-bottom: 16px; }
  .field label { display: block; margin-bottom: 6px; font-size: 13px; font-weight: 600; color: var(--ink); }
  .field input[type="text"], .field input[type="password"], .field input[type="file"], .field textarea { width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font: 15px var(--sans); color: var(--ink); background: #fff; }
  .field input:focus, .field textarea:focus { outline: 2px solid rgba(47, 91, 234, 0.35); border-color: var(--brand); }
  .field input[readonly] { background: var(--bg-alt); color: var(--muted); }
  .image-list { list-style: none; margin-top: 18px; display: grid; gap: 8px; font-size: 13px; }
  .image-list li { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }

  /* Footer */
  .site-footer { background: var(--ink); color: #cbd5e1; }
  .site-footer .brand { color: #fff; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px; padding: 56px 0 32px; }
  .footer-brand p { margin-top: 12px; max-width: 32ch; font-size: 14px; }
  .site-footer h4 { margin-bottom: 12px; color: #fff; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .site-footer ul { list-style: none; display: grid; gap: 8px; font-size: 14px; }
  .site-footer a { color: #cbd5e1; text-decoration: none; }
  .site-footer a:hover { color: #fff; }
  .footer-legal { padding: 20px 0 32px; border-top: 1px solid rgba(255, 255, 255, 0.12); font-size: 13px; color: #94a3b8; }

  @media (max-width: 900px) {
    .hero { padding: 56px 0 48px; }
    .hero-grid, .grid-3, .steps, .footer-grid { grid-template-columns: 1fr; }
    .section { padding: 56px 0; }
    .nav-wrap { padding-block: 12px; }
    .nav { gap: 12px; }
    .quote { padding: 32px 22px; }
  }
  @media (max-width: 560px) {
    .stats-grid { grid-template-columns: 1fr; }
    .nav-links { display: none; }
  }
</style>
